    "mastery_rating_per_1_mastery_point": 46
  },
  "mastery_model": {
    "base_mastery_percent_before_spec_coefficient": 8,
    "forward_formula": "displayed_mastery_percent = (8 + DR(mastery_rating / 46)) * spec_mastery_coefficient",
    "reverse_formula": "mastery_rating = reverse_DR(displayed_mastery_percent / spec_mastery_coefficient - 8) * 46",
    "worked_example": "毁灭术面板40%精通、专精系数2：40 / 2 = 20；20 - 8 = 12；12 * 46 = 552精通绿字（未进入递减区间）。",
    "warning": "必须先用面板精通除以专精系数，再减基础8%精通；不可直接用面板精通减8%。部分专精有多个效果，primary 只对应角色属性接口和 SimulationCraft 使用的主精通值。"
  },
  "sheet_percent_conversion_policy": {
    "model_version": "simple_v1",
    "mandatory_order": [
      "identify_spec_and_its_mastery_coefficient",
      "subtract_only_universal_base_5_percent_critical_strike",
      "for_mastery_divide_displayed_effect_by_spec_coefficient_then_subtract_only_8_percent_base_mastery",
      "reverse_secondary_stat_diminishing_returns",
      "convert_percent_or_mastery_points_to_rating",
      "subtract_static_rating_from_gems_enchants_flask_food_and_other_included_sources",
      "only_then_generate_equipment_rating_targets_or_ratios"
    ],
    "base_defaults": {
      "critical_strike_percent": 5,
      "haste_percent": 0,
      "mastery_percent_before_spec_coefficient": 8,
      "versatility_percent": 0
    },
    "mastery_forward_formula": "displayed_mastery_effect_percent = (8 + DR(mastery_rating / 46)) * spec_mastery_coefficient",
    "mastery_reverse_formula": "mastery_rating = reverse_DR(displayed_mastery_effect_percent / spec_mastery_coefficient - 8) * 46",
    "excluded_from_v1": [
      "class_and_spec_talent_percent_bonuses",
      "hero_talent_percent_bonuses",
      "racial_percent_bonuses",
      "raid_buffs_and_temporary_combat_buffs"
    ],
    "simplification_zh_cn": "第一版仅考虑通用基础5%暴击、0%急速、基础8%精通、0%全能；不扣除天赋、英雄天赋、种族或团队增益。基础8%精通先与绿字精通%相加，再乘对应专精的精通系数，得到最终面板精通效果。",
    "temporary_effect_policy": "Temporary combat buffs and triggered item effects are excluded unless the source recommendation explicitly measures them and labels that context.",
    "ratio_policy": "Never treat character-sheet percentages as rating ratios. Derive rating targets first; if a remainder stat has no fixed target, keep a threshold-plus-remainder rule instead of inventing a unique ratio."
  },
